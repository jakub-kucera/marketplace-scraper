# .env

SECRET_KEY=

EMAIL_SENDER=
EMAIL_RECEIVER=


TOR_PROXY_IP=localhost
TOR_PROXY_PASSWORD=root

LOCAL_IP_SUBNET=
#LOCAL_IP_SUBNET=


# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5435

# Sentry — leave empty to disable
SENTRY_DSN=

# Backups (docs/BACKUPS.md)
# Local nightly dumps work with none of this set; the restic vars add the
# off-host copy, which is what covers Pi loss/theft/corruption.
# The schedule is NOT here — it's the systemd timer in backup/systemd/.
BACKUP_KEEP_LOCAL=3

# Off-host copy. Leave RESTIC_REPOSITORY empty to keep dumps local only.
# Backblaze B2 via the S3-compatible endpoint:
#   RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/<bucket>/scraper
#   AWS_ACCESS_KEY_ID=<b2 application keyID>
#   AWS_SECRET_ACCESS_KEY=<b2 applicationKey>
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep a copy in a password manager. Losing it makes every backup permanently
# unreadable — that, not theft, is the failure this defends against.
RESTIC_PASSWORD=

# Retention. Capped at ~6 months to stay inside the PII window (BACKUPS.md §7).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Failure alerts + weekly heartbeat. Falls back to DISCORD_LOGGER_WEBHOOK_URL.
BACKUP_DISCORD_WEBHOOK_URL=
