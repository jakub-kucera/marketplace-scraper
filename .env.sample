# .env

SECRET_KEY=

EMAIL_SENDER=
EMAIL_RECEIVER=


TOR_PROXY_IP=localhost
TOR_PROXY_PASSWORD=root

LOCAL_IP_SUBNET=
#LOCAL_IP_SUBNET=


# Database
# POSTGRES_HOST is the *host-side* value, used by anything run outside a container —
# `pytest` (the suite runs on real Postgres) and a non-containerised `manage.py`. The
# compose services don't read it: docker-compose.yml pins POSTGRES_HOST=postgres in each
# service's `environment:` block, which overrides env_file.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Absolute base URL of *this* deployment
SITE_BASE_URL=http://localhost:8000

# Sentry — leave empty to disable
SENTRY_DSN=

# Backups (docs/BACKUPS.md)
# Local nightly dumps work with none of this set; the restic vars add the
# off-host copy, which is what covers Pi loss/theft/corruption.
# The schedule is NOT here — it's the systemd timer in backup/systemd/.
BACKUP_KEEP_LOCAL=3

# Off-host copy. Leave RESTIC_REPOSITORY empty to keep dumps local only.
# Backblaze B2 via the S3-compatible endpoint:
#   RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/<bucket>/scraper
#   AWS_ACCESS_KEY_ID=<b2 application keyID>
#   AWS_SECRET_ACCESS_KEY=<b2 applicationKey>
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep a copy in a password manager. Losing it makes every backup permanently
# unreadable — that, not theft, is the failure this defends against.
RESTIC_PASSWORD=

# Retention. Capped at ~6 months to stay inside the PII window (BACKUPS.md §7).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# Failure alerts + weekly heartbeat. Falls back to DISCORD_LOGGER_WEBHOOK_URL.
BACKUP_DISCORD_WEBHOOK_URL=

# --- LLM layer (llm/) ------------------------------------------------------
# NULL declines every call and opens no socket, which is why nothing has to opt *out*
# of LLM calls. Set a real provider only when something is meant to use one.
# NULL | ANTHROPIC
LLM_PROVIDER=NULL
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=

# A hard stop, not a warning: calls are declined *before* the provider is reached once
# month-to-date spend reaches this. Set 0 to disable LLM calls entirely.
LLM_MONTHLY_BUDGET_USD=5.0

# Response cache TTL in seconds. 0 disables. Per-process with the default cache backend.
LLM_CACHE_SECONDS=86400
